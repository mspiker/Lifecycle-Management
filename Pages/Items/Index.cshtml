@page
@model LifecycleManagement.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">Items</h1>
        <p class="text-muted mb-0">All lifecycle items</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Item
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @await Html.PartialAsync("_ItemTable", Model.Items)
    </div>
</div>
