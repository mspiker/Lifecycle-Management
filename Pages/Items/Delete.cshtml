@page
@model LifecycleManagement.Pages.Items.DeleteModel
@{
    ViewData["Title"] = "Delete Item";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-2"></i> Confirm Delete
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete this item? This action cannot be undone.</p>
                <dl class="row small">
                    <dt class="col-sm-4 text-muted">Name</dt>
                    <dd class="col-sm-8">@Model.Item.Name</dd>
                    <dt class="col-sm-4 text-muted">Type</dt>
                    <dd class="col-sm-8">@Model.Item.ItemType?.Name</dd>
                    <dt class="col-sm-4 text-muted">Expiration</dt>
                    <dd class="col-sm-8">@Model.Item.ExpirationDate.ToString("MMM d, yyyy")</dd>
                </dl>
                <form method="post">
                    <input type="hidden" asp-for="Item.Id" />
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Delete Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
