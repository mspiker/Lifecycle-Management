@page
@model LifecycleManagement.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register – Lifecycle Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: var(--bs-body-bg); display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .register-card { width: 100%; max-width: 420px; }
    </style>
</head>
<body>
    <div class="register-card px-3">
        <div class="text-center mb-4">
            <div style="font-size:2rem;color:#0d6efd" class="mb-2"><i class="bi bi-arrow-repeat"></i></div>
            <h1 class="h4 fw-bold mb-0">Create Account</h1>
            <p class="text-muted small">Join Lifecycle Management</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small">@Model.ErrorMessage</div>
        }

        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Display Name</label>
                        <input asp-for="DisplayName" class="form-control form-control-sm" placeholder="Your name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Email</label>
                        <input asp-for="Email" class="form-control form-control-sm" type="email" placeholder="you@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Password</label>
                        <input asp-for="Password" class="form-control form-control-sm" type="password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-sm" type="password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-sm">
                        <i class="bi bi-person-plus me-1"></i> Create Account
                    </button>
                </form>
            </div>
        </div>
        <div class="text-center mt-3">
            <a asp-page="/Account/Login" class="text-muted small">Already have an account? Sign In</a>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
