@page
@model LifecycleManagement.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In – Lifecycle Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: var(--bs-body-bg); display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .login-card { width: 100%; max-width: 420px; }
        .brand-icon { font-size: 2rem; color: var(--color-primary); }
    </style>
</head>
<body>
    <div class="login-card px-3">
        <div class="text-center mb-4">
            <div class="brand-icon mb-2"><i class="bi bi-arrow-repeat"></i></div>
            <h1 class="h4 fw-bold mb-0">Lifecycle Management</h1>
            <p class="text-muted small">Sign in to your account</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-sm py-2 small">@Model.ErrorMessage</div>
        }

        @if (Model.AuthMode != "Entra")
        {
            <div class="card mb-3">
                <div class="card-body">
                    <form method="post" asp-page-handler="Local">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Email</label>
                            <input asp-for="Email" class="form-control form-control-sm" type="email" autocomplete="email" placeholder="you@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Password</label>
                            <input asp-for="Password" class="form-control form-control-sm" type="password" autocomplete="current-password" />
                        </div>
                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                            <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.AuthMode == "Hybrid")
            {
                <div class="text-center text-muted small mb-3">— or —</div>
            }
        }

        @if (Model.AuthMode != "Local")
        {
            <form method="post" asp-page-handler="Entra">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-outline-primary w-100 btn-sm">
                    <i class="bi bi-microsoft me-2"></i> Sign in with Microsoft
                </button>
            </form>
        }

        @if (Model.AuthMode != "Entra")
        {
            <div class="text-center mt-3">
                <a asp-page="/Account/Register" class="text-muted small">Don't have an account? Register</a>
            </div>
        }
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
