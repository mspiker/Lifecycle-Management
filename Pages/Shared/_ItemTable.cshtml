@model List<LifecycleManagement.Models.ItemViewModel>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        <p>No items found.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Owner</th>
                    <th>Expiration</th>
                    <th>Days Left</th>
                    <th>Lead Time</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vm in Model)
                {
                    <tr>
                        <td class="fw-medium">@vm.Item.Name</td>
                        <td><span class="badge bg-light text-dark border">@vm.Item.ItemType?.Name</span></td>
                        <td class="text-muted small">@vm.OwnerName</td>
                        <td class="small">@vm.Item.ExpirationDate.ToString("MMM d, yyyy")</td>
                        <td>
                            @if (vm.DaysRemaining < 0)
                            {
                                <span class="text-danger fw-bold">@Math.Abs(vm.DaysRemaining)d overdue</span>
                            }
                            else
                            {
                                <span>@vm.DaysRemaining d</span>
                            }
                        </td>
                        <td class="small text-muted">@vm.EffectiveLeadDays d</td>
                        <td>
                            @{
                                var badgeClass = vm.UrgencyStatus switch
                                {
                                    "Critical" => "badge-critical",
                                    "Approaching" => "badge-approaching",
                                    _ => "badge-safe"
                                };
                            }
                            <span class="badge @badgeClass">@vm.UrgencyStatus</span>
                        </td>
                        <td class="text-end">
                            <a asp-page="/Items/Details" asp-route-id="@vm.Item.Id" class="btn btn-sm btn-outline-secondary py-0">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="/Items/Edit" asp-route-id="@vm.Item.Id" class="btn btn-sm btn-outline-primary py-0">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
