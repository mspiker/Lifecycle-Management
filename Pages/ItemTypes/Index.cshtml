@page
@model LifecycleManagement.Pages.ItemTypes.IndexModel
@{
    ViewData["Title"] = "Item Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold">Item Types</h1>
        <p class="text-muted mb-0">Manage lifecycle item categories</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Type
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Default Lead Days</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.ItemTypes)
                {
                    <tr>
                        <td class="fw-medium">@t.Name</td>
                        <td>@t.DefaultLeadDays days</td>
                        <td class="text-muted small">@(t.Description ?? "-")</td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary py-0">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-page="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger py-0">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
