@page
@model LifecycleManagement.Pages.ItemTypes.EditModel
@{
    ViewData["Title"] = "Edit Item Type";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="./Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
            <h1 class="h3 mb-0 fw-bold">Edit Item Type</h1>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="ItemType.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ItemType.Name" class="form-label fw-medium">Name <span class="text-danger">*</span></label>
                            <input asp-for="ItemType.Name" class="form-control" />
                            <span asp-validation-for="ItemType.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ItemType.DefaultLeadDays" class="form-label fw-medium">Default Lead Days <span class="text-danger">*</span></label>
                            <input asp-for="ItemType.DefaultLeadDays" class="form-control" type="number" min="1" />
                            <span asp-validation-for="ItemType.DefaultLeadDays" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="ItemType.IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="ItemType.IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="ItemType.Description" class="form-label fw-medium">Description</label>
                            <textarea asp-for="ItemType.Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
