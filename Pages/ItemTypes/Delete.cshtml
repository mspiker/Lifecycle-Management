@page
@model LifecycleManagement.Pages.ItemTypes.DeleteModel
@{
    ViewData["Title"] = "Delete Item Type";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-2"></i> Confirm Delete
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete this item type?</p>
                <dl class="row small">
                    <dt class="col-sm-4 text-muted">Name</dt>
                    <dd class="col-sm-8">@Model.ItemType.Name</dd>
                    <dt class="col-sm-4 text-muted">Lead Days</dt>
                    <dd class="col-sm-8">@Model.ItemType.DefaultLeadDays days</dd>
                </dl>
                <form method="post">
                    <input type="hidden" asp-for="ItemType.Id" />
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
